# Streamboard — one ignore file for the whole project (app/ and server/).
#
# Patterns without a leading slash match at any depth, so `node_modules/` covers
# both halves. Anything that names a specific half is written out in full.

# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/

# ─── Build output ───────────────────────────────────────────────────────────
# app/ is Next.js, server/ compiles with tsc to dist/.
.next/
out/
build/
server/dist/
*.tsbuildinfo

# Generated by `next dev` on every run, not written by hand.
next-env.d.ts

# ─── Secrets ────────────────────────────────────────────────────────────────
# server/.env holds TWITCH_CLIENT_ID and the editor override list.
.env
.env.*
*.pem

# ─── Live board state ───────────────────────────────────────────────────────
# This is the running server's data, not the project's source.
#
#   boards/    one directory per channel: its items, its saved layouts, and its
#              board.json — which holds that board's overlay key. That key is a
#              shared secret, so this one matters more than the rest.
#   uploads/   images people have dropped onto a board.
#   *.json     snapshots from earlier storage layouts, still sitting where the
#              server used to keep them.
server/boards/
server/uploads/
server/emotes.json
server/items.json
server/layouts.json

# ─── Agent tooling ──────────────────────────────────────────────────────────
# None of this is project source. The skills under .agents/ and .claude/ are
# copies of files that ship inside the @awesome.me/webawesome package, and
# skills-lock.json only records where they were copied from — so with all three
# ignored, a fresh clone starts without them and re-syncing from the installed
# package is what puts them back.
#
# All of these match at any depth, covering the root copies and app/'s.
.agents/
.claude/
skills-lock.json

# Agent instructions. Part of app's AGENTS.md is rewritten by `next dev` on
# every run, so keeping these out is one less file that changes on its own.
AGENTS.md
CLAUDE.md

# ─── Logs and local noise ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/

# ─── OS and editor ──────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
